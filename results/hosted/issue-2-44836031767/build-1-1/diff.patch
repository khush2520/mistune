@@ -0,0 +1,14 @@
+import pytest
+from mistune.toc import add_toc_hook, normalize_toc_item
+
+@pytest.mark.parametrize('input_html, expected_id', [
+    ('<div data-id="toc_1"></div>\n# Heading', 'toc_1'),
+    ('<div id="toc_1"></div>\n# Heading', 'toc_1_1')
+])
+def test_add_toc_hook(input_html, expected_id):
+    md = mistune.create_markdown()
+    add_toc_hook(md)
+    html, state = md.parse(input_html)
+    toc_items = state.env['toc_items']
+    assert len(toc_items) == 1
+    assert toc_items[0][1] == expected_id
