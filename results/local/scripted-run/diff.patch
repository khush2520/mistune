@@ -0,0 +1,13 @@
+import subprocess
+import sys
+from pathlib import Path
+
+
+def test_ac_01(tmp_path, monkeypatch):
+    dash = tmp_path / "-"
+    dash.write_text("keep")
+    monkeypatch.setenv("PYTHONPATH", str(Path(__file__).resolve().parents[1] / "src"))
+    command = [sys.executable, "-m", "mistune", "-m", "Hi", "--output", "-"]
+    result = subprocess.run(command, cwd=tmp_path, text=True, capture_output=True, check=True)
+    assert result.stdout == "<p>Hi</p>\n\n"
+    assert dash.read_text() == "keep"
